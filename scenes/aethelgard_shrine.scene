# scenes/aethelgard_shrine.scene
#
# "The Astral Spring & Crystal Shrine of Aethelgard"
#
# An advanced, enchanted high-fantasy grotto sanctuary at magical twilight.
# Features:
#   * Powerful Volumetric God-Rays (shadow_steps = 14):
#       - High-intensity divine moonlight (sun_color 5.5 4.6 6.8) angled from upper-left
#       - Intricate volumetric shadow shafts cast by vaulted living arch ribs & canopy gaps
#       - Forward Mie scattering (sun_anisotropy = 0.84) creating dramatic visible light beams
#       - Ground mist turbulence clinging to the water surface (noise_scale & noise_amount)
#   * Organic Living Architecture & Highly Structured Textures:
#       - Bundled elven tree-pillars with secondary spiraling vine shafts & root buttresses
#       - Living vaulted arch ribs spanning across the ceiling with gilded keystone bosses
#       - Deep 3D procedural bump mapping (bump_strength 0.45, bump_scale 3.5) on bark & carved stone
#       - 3D continuous fBm noise texture on ancient stone and petrified wood
#   * Shimmering Reflecting Pool & Water Physics:
#       - Wave normal perturbation with harmonic ripples (is_water = 1)
#       - Beer-Lambert cyan/turquoise wavelength absorption
#       - Submerged tiled pool basin (texture = image with textures/tiles.bmp) visible through water
#       - Submerged glowing abyssal relic casting light up through the rippled surface
#   * Complex Analytical CSG (Constructive Solid Geometry):
#       - csg_difference + csg_union: Monumental Elven Moon Portal Arch with gilded bronze lining
#       - csg_intersection: Biconvex sapphire optical lens focusing light on the left plinth
#       - csg_difference: Gilded sacrificial chalice with ruby gemstone interior on the right plinth
#   * Wavefront OBJ Mesh Relics:
#       - Floating celestial astrolabe halo in polished gold (models/torus.obj)
#       - Floating multifaceted arcane crystal core (models/icosahedron.obj) hovering at the epicenter
#   * Rich Palette of 7 Magical Light Sources:
#       - Central Radiant Celestial Core (azure/cyan)
#       - Submerged Abyssal Relic (deep oceanic teal)
#       - Sacred Twin Braziers (vivid magenta fire & warm amber sunfire)
#       - Altar Relic Wisps (emerald life-crystal & royal amethyst)
#       - Twin Distant Guardian Beacons (celestial sapphire wisps)
#   * Procedural Natural Flora & Geology:
#       - Ancient Elven World Tree with 3D folded polygonal diamond leaves (foliage = leaves)
#       - Enchanted Nordic Spruces with dense conifer needle fronds (foliage = needles)
#       - Procedurally deformed mossy boulders with 3D surface roughness (boulder)
#       - Bioluminescent shrubbery and velvet moss ground
#   * Thin-Lens Optical Camera:
#       - Subtle depth of field focusing sharply on the floating celestial core and rings

water_level = 0.08
water_material = grotto_water
water_enabled = 1

camera {
    eye = 0.0 2.2 9.5
    target = 0.0 2.5 -0.5
    up = 0 1 0
    vfov = 44.0
    aperture = 0.005
    focus_distance = 10.0
}

sky {
    sun_dir = -0.355 0.630 -0.691
    sun_color = 0.65 1.15 2.50
    horizon_color = 0.002 0.003 0.006
    zenith_color = 0.0005 0.0005 0.0012
    gradient_gamma = 0.85
    sun_glow_exponent = 400.0
    sun_glow_strength = 0.35
    sun_radius = 1.2
    cloud_height = 180.0
    cloud_scale = 0.0025
    cloud_coverage = 2.0
    cloud_softness = 0.20
    cloud_sharpness = 1.40
    seed = 8844
    star_intensity = 4.0
    star_density = 340.0
    nebula_intensity = 0.50
    nebula_scale = 18.0
    nebula_dir = 0.12 0.30 -0.94
    galaxy_intensity = 0.65
    galaxy_dir = -0.25 0.38 -0.89
    galaxy_tilt = 46.0
    galaxy_roll = -32.0
}

fog {
    density = 0.010
    color = 0.006 0.012 0.026
    height = 2.2
    height_falloff = 0.45
    inscatter_strength = 0.44
    sun_anisotropy = 0.78
    noise_scale = 0.18
    noise_amount = 0.22
    shadow_steps = 14
}

# --- Materials -------------------------------------------------------------

material grotto_water {
    type = water
    albedo = 0.01 0.04 0.06
    specular = 0.96 0.96 0.96
    shininess = 256.0
    reflectivity = 0.95
    transparency = 0.85
    absorption = 0.45 0.14 0.05
    deep_color = 0.02 0.35 0.48
    ior = 1.333
    is_water = 1
    bump_strength = 0.45
    bump_scale = 3.2
}

