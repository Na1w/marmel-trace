    base = 0.0 -0.20 2.2
    top = 0.0 -0.04 2.2
    r_bottom = 0.45
    r_top = 0.36
    material = weathered_elven_stone
}
sphere {
    center = 0.0 0.04 2.2
    radius = 0.20
    material = submerged_crystal
}

