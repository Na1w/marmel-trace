# scenes/cyberpunk_cityscape.scene
#
# "Neo-Shinjuku 2099: The Vertical Sprawl"
#
# A complex, multi-tiered cyberpunk metropolis skyline viewed from a high rooftop terrace.
#
# Key Features:
#   * Wide canyon view between towering megastructures and needle spires
#   * Fine architectural window grids and horizontal ventilation louvers
#   * Multi-level skybridges spanning across the urban canyon
#   * Glowing holographic neon advertising billboards & vertical kanji banners
#   * Streams of flying aerocars (spinners) with glowing headlights and red taillights
#   * Rooftop infrastructure: communications array, radar dishes, and red aviation beacons
#   * Dark reflective urban canal in the canyon depths reflecting the glowing skyline
#   * Path-traced global illumination with multithreading (--threads --pathtrace)
#
# Render:
#   ./raytracer --threads --scene scenes/cyberpunk_cityscape.scene --pathtrace \
#               --width 1280 --height 720 --samples 32 --depth 6 \
#               --out output/cyberpunk_cityscape.bmp

water_level = 0.05
water_material = canal_water
water_enabled = 1
camera {
    eye = 0 22 46
    target = 0 15 -10
    up = 0 1 0
    vfov = 50.0
    aperture = 0.012
    focus_distance = 46.0
}
sky {
    sun_dir = 0.1 0.9 -0.4
    sun_color = 0.02 0.02 0.03
    horizon_color = 0.08 0.07 0.15
    zenith_color = 0.015 0.02 0.04
    gradient_gamma = 0.75
    sun_glow_exponent = 200.0
    sun_glow_strength = 0.1
    cloud_height = 120.0
    cloud_scale = 0.0035
    cloud_coverage = 0.88
    cloud_softness = 0.18
    cloud_sharpness = 1.2
    cloud_octaves = 5
    seed = 2099
}
