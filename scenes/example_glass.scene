# scenes/example_glass.scene
#
# A demonstration scene for the GENERAL REFRACTION / GLASS material support
# described in docs/scene_format.md, §4.3 ("Materials", `type = glass` and the
# `beer_lambert` key).
#
# The three glass behaviours this scene shows off:
#
#   * CLEAR GLASS (`type = glass`) -- the preset is
#         albedo 0.02 0.02 0.02, specular 1 1 1, shininess 256,
#         reflectivity 0, transparency 1, ior 1.5, is_water 0,
#         beer_lambert 0, absorption 0 0 0, deep_color 0.5 0.5 0.5.
#     With `is_water = 0` the geometric surface normal is used verbatim (no
#     wave perturbation) and, because `beer_lambert = 0`, `absorption` is a
#     no-op: the sphere is a pure refracting lens that inverts/magnifies the
#     striped wall and the coloured spheres behind it.
#
#   * TINTED GLASS (`type = glass` + `beer_lambert = 1`) -- the independent
#     `beer_lambert` flag turns ON Beer-Lambert depth absorption along the
#     transmitted ray, WITHOUT the wave-normal perturbation that `is_water`
#     would also add. Attenuation is per channel:
#         T_c     = exp(-absorption_c * depth)
#         out_c   = inner_c * T_c + deep_color_c * (1 - T_c)
#     A large red/blue absorption with a green `deep_color` tints the medium
#     green, and the tint deepens toward the centre of the sphere where the
#     transmitted path is longest. `absorption = 0 0 0` would reproduce the
#     clear look, so the colour is entirely data-driven.
#
#   * CUSTOM IOR (`type = glass` + `ior = 2.4`) -- an explicit `ior` overrides
#     the preset's 1.5. A higher index of refraction bends the rays far more,
#     giving a hard, diamond-like lens with strong total-internal-reflection
#     sparkle compared to the 1.5 spheres beside it. (Set it to 1.33 for a
#     much softer, water-like bend instead.)
#
# Background structure: a checkerboard floor, a red/blue striped wall, and two
# opaque coloured spheres, all arranged BEHIND the glass so the refraction and
# reflection are easy to read. The scene is fully deterministic (all noise
# comes from the `seed` keys); there is no randomness beyond that.
#
# Render it with:
#   ./raytracer --scene scenes/example_glass.scene \
#               --width 320 --height 180 --samples 8 --out /tmp/ex_glass.bmp
#
# Try the effect toggles:
#   * set `beer_lambert = 0`  -> the green sphere turns clear (absorption off).
#   * set `ior = 1.0`         -> the diamond sphere stops bending light.
#   * set `absorption = 0 0 0` -> the green sphere loses its depth tint.

# --- Globals ---------------------------------------------------------------
# This scene has no water surface, so disable the water pass explicitly (the
# glass look comes entirely from per-material `is_water = 0` + refraction).
water_enabled = 0
water_material = none

# --- Camera ----------------------------------------------------------------
# Eye a little above the glass, looking down the -Z axis into the scene. A
# modest field of view keeps the glass lenses large in frame so their bending
# of the background is obvious.
camera {
    eye = 0 2.6 13
    target = 0 1.4 -2
    up = 0 1 0
    vfov = 42
}

# --- Sky -------------------------------------------------------------------
# A bright, slightly warm daytime sky. Clouds and the sun glow give the clear
# glass something soft and gradient-y to refract at the top of the frame.
sky {
    sun_dir = 0.45 0.70 -0.55
    sun_color = 1 0.96 0.9
    horizon_color = 0.8 0.88 1
    zenith_color = 0.3 0.5 0.95
    gradient_gamma = 0.65
    sun_glow_exponent = 320
    sun_glow_strength = 0.85
    cloud_height = 120
    cloud_scale = 0.0025
    cloud_coverage = 0.4
    cloud_softness = 0.15
    cloud_sharpness = 1.4
    cloud_octaves = 5
    seed = 90210
}

# --- Materials -------------------------------------------------------------
# Checkerboard floor: white albedo so the pattern colours show verbatim.
# 1-unit cells alternating light grey and near-black blue.
material checker_floor {
    albedo = 1 1 1
    specular = 0.05 0.05 0.05
    shininess = 16
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
    texture = checker
    texture_scale = 1.0
    texture_color_a = 0.9 0.9 0.9
    texture_color_b = 0.1 0.12 0.16
}

# Striped backdrop wall: horizontal red/blue bands (stripes run along world Y,
# so on a vertical wall they read as clean horizontal stripes). This is the
# structured pattern the glass lenses bend and invert.
material stripes_wall {
    albedo = 1 1 1
    specular = 0.08 0.08 0.08
    shininess = 20
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
    texture = stripes
    texture_scale = 2.0
    texture_color_a = 0.88 0.22 0.18
    texture_color_b = 0.14 0.38 0.82
}

# Opaque accent spheres -- non-transmissive references so the eye can compare
# "seen directly" vs "seen through glass".
material matte_orange {
    albedo = 0.86 0.36 0.12
    specular = 0.15 0.15 0.15
    shininess = 48
    reflectivity = 0.05
    transparency = 0
    ior = 1.5
    is_water = 0
}

material matte_teal {
    albedo = 0.1 0.55 0.56
    specular = 0.15 0.15 0.15
    shininess = 48
    reflectivity = 0.05
    transparency = 0
    ior = 1.5
    is_water = 0
}

# 1) CLEAR GLASS -- the bare preset, no overrides at all. A pure refracting
#    lens at the default ior 1.5.
material glass_clear {
    type = glass
}

# 2) TINTED GLASS -- same glass preset, but `beer_lambert = 1` enables
#    Beer-Lambert depth absorption (and NOT the water wave perturbation).
#    Red and blue are absorbed strongly while green passes, so the medium
#    reads green; `deep_color` is the colour reached as depth -> infinity.
material glass_green {
    type = glass
    beer_lambert = 1
    absorption = 1.3 0.2 1.1
    deep_color = 0.02 0.25 0.05
}

# 3) CUSTOM IOR -- the glass preset with an explicit `ior` that overrides the
#    default 1.5. 2.4 gives a hard, diamond-like bend and lots of internal
#    reflection (try 1.33 for a softer, water-like refraction).
material glass_diamond {
    type = glass
    ior = 2.4
}

# --- Primitives ------------------------------------------------------------
# Infinite checkerboard ground at y = 0.
plane {
    point = 0 0 0
    normal = 0 1 0
    material = checker_floor
}

# Striped backdrop wall: a thin box from x=-11..11, y=0..5.6, at z ~ -8.
# Its top edge sits below the horizon so sky and clouds remain visible above.
box {
    center = 0 2.8 -8
    half = 11 2.8 0.3
    material = stripes_wall
}

# Two opaque coloured spheres resting on the floor, behind the glass.
sphere {
    center = -3.4 1.1 -3.5
    radius = 1.1
    material = matte_orange
}

sphere {
    center = 3.4 1.1 -3.5
    radius = 1.1
    material = matte_teal
}

# CLEAR GLASS lens (left, in front): rests on the floor and refracts the
# stripes and the orange sphere behind it (they appear inverted/magnified).
sphere {
    center = -1.6 1.6 0
    radius = 1.6
    material = glass_clear
}

# TINTED GLASS lens (right, in front): identical geometry to the clear one,
# but the green Beer-Lambert medium darkens with depth through the sphere.
sphere {
    center = 1.6 1.6 0
    radius = 1.6
    material = glass_green
}

# DIAMOND-like glass gem (centre, floating between the two lenses): a much
# higher ior makes the refracted image compress hard and sparkle with internal
# reflection, in contrast to the 1.5 lenses on either side.
sphere {
    center = 0 2.4 -2.2
    radius = 0.9
    material = glass_diamond
}
