}

material manta_dorsal {
    pbr = 1
    albedo = 0.14 0.16 0.20
    specular = 0.08 0.08 0.08
    roughness = 0.28
}

material manta_ventral {
    pbr = 1
    albedo = 0.88 0.90 0.92
    specular = 0.06 0.06 0.06
    roughness = 0.35
}

material purple_coral_rock {
    pbr = 1
    albedo = 0.52 0.24 0.55
    specular = 0.05 0.05 0.05
    roughness = 0.80
    bump_strength = 0.30
    bump_scale = 2.0
}

material turquoise_coral_rock {
    pbr = 1
    albedo = 0.20 0.58 0.52
    specular = 0.05 0.05 0.05
    roughness = 0.78
    bump_strength = 0.28
    bump_scale = 2.0
}

material coastal_pine_bark {
    pbr = 1
    albedo = 0.18 0.12 0.08
    roughness = 0.92
}

material coastal_pine_leaf {
    pbr = 1
    albedo = 0.06 0.28 0.05
    roughness = 0.70
}

# --- The Procedural Ocean Surface & Medium ---------------------------------
ocean {
    material = ocean_water
    center = 0.0 0.0 0.0
    size = 60.0 60.0
    resolution = 180 180
    amplitude = 0.24
    wavelength = 6.0
    direction = 0.80 0.60
    steepness = 0.70
    chop = 0.08
    chop_wavelength = 2.0
    depth = 6.0
    seed = 8844
}

# --- Above-Water Scenery: Natural Sea Arch & Karst Pinnacles --------------

# Monolithic Sea Arch Stack on the right, rising from the sea with open arch
csg_difference {
    material = karst_limestone
    box {
        center = 4.4 0.3 -6.5
        half = 1.7 2.1 2.5
    }
    csg_union {
        cylinder {
            base = 4.2 -0.3 -10.0
            top = 4.2 -0.3 -3.0
            r_bottom = 1.5
            r_top = 1.5
            material = karst_cave_rock
        }
        cylinder {
            base = 3.3 -1.2 -4.5
            top = 4.7 2.6 -8.3
            r_bottom = 1.4
            r_top = 1.4
            material = karst_cave_rock
        }
    }
}

# Windswept Coastal Pine growing atop the Sea Arch
tree {
    position = 3.6 2.4 -6.5
    type = conifer
    height = 2.2
    radius = 0.15
    seed = 732
    material_bark = coastal_pine_bark
    material_leaf = coastal_pine_leaf
}

# Rugged Karst Limestone Pinnacles in the background
cylinder {
    base = -16.0 -3.0 -28.0
    top = -16.0 6.5 -28.0
    r_bottom = 4.5
    r_top = 2.8
    material = karst_limestone
}
sphere {
    center = -16.0 6.5 -28.0
    radius = 2.8
    material = karst_limestone
}
tree {
    position = -16.0 9.3 -28.0
    type = conifer
    height = 2.0
    radius = 0.12
    seed = 415
    material_bark = coastal_pine_bark
    material_leaf = coastal_pine_leaf
}

cylinder {
    base = -7.5 -2.5 -22.0
    top = -7.5 4.5 -22.0
    r_bottom = 3.0
    r_top = 1.6
    material = karst_limestone
}
sphere {
    center = -7.5 4.5 -22.0
    radius = 1.6
    material = karst_limestone
}
tree {
    position = -7.5 6.1 -22.0
    type = conifer
    height = 1.8
    radius = 0.10
    seed = 551
    material_bark = coastal_pine_bark
    material_leaf = coastal_pine_leaf
}

# --- Underwater World: Seabed & CSG Organic Marine Formations -------------

# Sandy seabed
box {
    center = 0.0 -1.5 0.0
    half = 30.0 0.5 30.0
    material = tropical_sand
}

# CSG Feature 1: The Giant Clam with Bioluminescent Pearl (Open toward camera)
# Lower Shell Half resting on the seabed
csg_difference {
    material = clam_outer_shell
    sphere {
        center = -0.62 -0.82 0.70
        radius = 0.38
    }
    csg_union {
        sphere {
            center = -0.62 -0.75 0.70
            radius = 0.34
            material = clam_inner_nacre
        }
        box {
            center = -0.62 -0.35 0.70
            half = 0.5 0.25 0.5
            material = clam_inner_nacre
        }
    }
}

# Upper Shell Half (Hinged at back, tilted open facing camera)
csg_difference {
    material = clam_outer_shell
    sphere {
        center = -0.62 -0.58 0.55
        radius = 0.36
    }
    csg_union {
        sphere {
            center = -0.62 -0.54 0.58
            radius = 0.32
            material = clam_inner_nacre
        }
        box {
            center = -0.62 -0.88 0.58
            half = 0.5 0.25 0.5
            material = clam_inner_nacre
        }
    }
}

# The Bioluminescent Pearl inside the Clam (Emissive Area Light)
sphere {
    center = -0.62 -0.75 0.70
    radius = 0.09
    material = luminous_pearl
}

# CSG Feature 2: Organic Brain Coral Head with Golden Sponge Cavity
csg_difference {
    material = brain_coral
    sphere {
        center = 0.70 -0.60 0.65
        radius = 0.46
    }
    cylinder {
        base = 0.70 -1.1 0.65
        top = 0.70 -0.1 0.65
        r_bottom = 0.20
        r_top = 0.20
        material = golden_sponge
    }
}

# CSG Feature 3: Biconvex Emerald Sea Fan (CSG Intersection of 2 Spheres)
csg_intersection {
    material = emerald_fan
    sphere {
        center = 0.38 -0.50 0.50
        radius = 0.36
    }
    sphere {
        center = 0.38 -0.50 0.28
        radius = 0.36
    }
}

# CSG Feature 4: Sunken Terracotta Amphora (CSG Difference: Outer Urn minus Inner Hollow)
csg_difference {
    material = terracotta_urn
    cylinder {
        base = -0.38 -0.85 -0.10
        top = -0.38 -0.25 -0.10
        r_bottom = 0.13
        r_top = 0.19
    }
    cylinder {
        base = -0.38 -0.75 -0.10
        top = -0.38 -0.12 -0.10
        r_bottom = 0.09
        r_top = 0.15
        material = antique_gold
    }
}
sphere {
    center = -0.38 -0.62 -0.10
    radius = 0.22
    material = terracotta_urn
}

# Feature 5: Manta Ray Gliding in the Shallows (Sleek aerodynamic profile)
sphere {
    center = 0.16 -0.38 0.82
    radius = 0.15
    material = manta_dorsal
}
triangle {
    a = 0.16 -0.38 0.98
    b = -0.32 -0.38 0.65
    c = 0.16 -0.38 0.58
    material = manta_dorsal
}
triangle {
    a = 0.16 -0.38 0.98
    b = 0.64 -0.38 0.65
    c = 0.16 -0.38 0.58
    material = manta_dorsal
}
cylinder {
    base = 0.16 -0.38 0.58
    top = 0.16 -0.36 0.08
    r_bottom = 0.012
    r_top = 0.005
    material = manta_dorsal
}

