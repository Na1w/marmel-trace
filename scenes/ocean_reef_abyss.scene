    albedo = 0.98 0.74 0.15
    specular = 0.04 0.04 0.04
    roughness = 0.75
    bump_strength = 0.25
    bump_scale = 2.8
}

material emerald_fan {
    type = glass
    beer_lambert = 1
    ior = 1.55
    absorption = 1.40 0.04 0.75
