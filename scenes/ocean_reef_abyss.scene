# scenes/ocean_reef_abyss.scene
#
# "The Sunken Reef & Sea Arch — Over & Under"
#
# A 50/50 split-waterline ocean showcase capturing both above and below the surface:
# Above: Crisp coastal morning, cumulus clouds, natural karst sea arch and limestone pinnacles.
# Below: Crystal-clear turquoise ocean with Snell refraction, Beer-Lambert wavelength
#        absorption, wave slope perturbation, and organic CSG marine structures:
#          * csg_difference: Monolithic sea arch carved through limestone sea cliff
#          * csg_difference + csg_union: Giant open Tridacna clam shell with nacre interior
#          * Bioluminescent pearl (emissive area light) casting vivid cyan glow through the water
#          * csg_difference: Porous brain coral dome with golden sponge cavity
#          * csg_intersection: Biconvex emerald sea fan with refractive Beer-Lambert glass
#          * csg_difference: Sunken ancient terracotta amphora resting on the sandy seabed
#          * Manta ray gliding through the sunlit tropical shallows
#          * Rippled white tropical sand seabed, coral boulders, and windswept clifftop pine

water_level = 0.0
water_material = ocean_water
water_enabled = 1

camera {
    eye = 0.0 0.20 1.4
    target = 0.0 0.18 -1.0
    up = 0 1 0
    vfov = 54.0
    dome_radius = 0.12
    aperture = 0.001
    focus_distance = 2.2
}

sky {
    sun_dir = 0.25 0.68 -0.68
    sun_color = 3.2 2.2 1.2
    horizon_color = 0.60 0.76 0.90
    zenith_color = 0.08 0.30 0.82
    gradient_gamma = 0.75
    sun_glow_exponent = 450.0
    sun_glow_strength = 0.35
    sun_radius = 1.6
    cloud_height = 85.0
    cloud_thickness = 45.0
    cloud_scale = 0.0050
    cloud_coverage = 0.58
    cloud_softness = 0.10
    cloud_sharpness = 1.50
    cloud_octaves = 5
    cloud_density = 0.14
    cloud_steps = 20
    seed = 8844
}

fog {
    density = 0.003
    color = 0.65 0.78 0.90
    height = 1.8
    height_falloff = 0.50
    inscatter_strength = 0.60
    sun_anisotropy = 0.75
    noise_scale = 0.20
    noise_amount = 0.10
    shadow_steps = 16
}

# --- Materials -------------------------------------------------------------

material ocean_water {
    type = water
    albedo = 0.02 0.06 0.08
    specular = 0.98 0.98 0.98
    shininess = 256.0
    reflectivity = 0.0
    transparency = 1.0
    ior = 1.333
    is_water = 1
    absorption = 0.85 0.22 0.06
    deep_color = 0.02 0.46 0.56
}

material tropical_sand {
    pbr = 1
    albedo = 0.70 0.64 0.50
    specular = 0.04 0.04 0.04
    roughness = 0.78
    bump_strength = 0.25
    bump_scale = 3.0
}

material karst_limestone {
    pbr = 1
    albedo = 0.28 0.25 0.22
    specular = 0.04 0.04 0.04
    roughness = 0.85
    bump_strength = 0.35
    bump_scale = 1.8
}

material karst_cave_rock {
    pbr = 1
    albedo = 0.12 0.10 0.09
    specular = 0.04 0.04 0.04
    roughness = 0.90
    bump_strength = 0.35
    bump_scale = 1.5
}

material clam_outer_shell {
    pbr = 1
    albedo = 0.54 0.48 0.40
    specular = 0.05 0.05 0.05
    roughness = 0.70
    bump_strength = 0.30
    bump_scale = 2.2
}

material clam_inner_nacre {
    pbr = 1
    albedo = 0.96 0.94 0.92
    specular = 0.35 0.38 0.42
    roughness = 0.12
}

material luminous_pearl {
    pbr = 1
    albedo = 0.5 0.98 0.95
    emissive = 5.0 18.0 20.0
    roughness = 0.04
}

material brain_coral {
    pbr = 1
    albedo = 0.94 0.36 0.44
    specular = 0.06 0.06 0.06
    roughness = 0.60
    bump_strength = 0.35
    bump_scale = 3.5
}

material golden_sponge {
