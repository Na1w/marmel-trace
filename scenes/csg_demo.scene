# scenes/csg_demo.scene
#
# Constructive Solid Geometry (CSG) Showcase
# Demonstrating:
#   * csg_difference: sphere carved through by a cylinder with contrasting interior material
#   * csg_difference: stone cube carved with circular bore holes (archways / tunnels)
#   * csg_intersection: emerald glass lens from intersecting spheres
#   * csg_union: composite sculpture pedestal

camera {
    eye = 0.0 2.2 6.0
    target = 0.0 0.8 0.0
    up = 0 1 0
    vfov = 38.0
}

sky {
    sun_dir = 0.5 0.7 -0.4
    sun_color = 1.0 0.95 0.88
    horizon_color = 0.75 0.82 0.92
    zenith_color = 0.20 0.45 0.85
    gradient_gamma = 0.8
    cloud_coverage = 0.2
}

# --- Materials -------------------------------------------------------------

material floor_mat {
    albedo = 0.35 0.35 0.38
    roughness = 0.6
    specular = 0.1 0.1 0.1
    shininess = 20.0
}

material granite_rock {
    albedo = 0.45 0.42 0.40
    roughness = 0.5
    specular = 0.1 0.1 0.1
    shininess = 32.0
}

material gold_core {
    pbr = 1
    albedo = 1.0 0.78 0.28
    roughness = 0.18
    metallic = 0.95
    specular = 0.95 0.85 0.5
    shininess = 128.0
}

material carved_stone {
    albedo = 0.55 0.35 0.25
    roughness = 0.65
    specular = 0.08 0.08 0.08
    shininess = 16.0
}

material cobalt_core {
    pbr = 1
    albedo = 0.12 0.45 0.92
    roughness = 0.2
    metallic = 0.8
}

material emerald_glass {
    albedo = 0.1 0.85 0.4
    transparency = 0.9
    reflectivity = 0.8
    ior = 1.52
    beer_lambert = 1
    absorption = 0.15 0.02 0.08
    roughness = 0.02
}

material brass_pedestal {
    pbr = 1
    albedo = 0.88 0.72 0.32
    roughness = 0.35
    metallic = 0.75
}

# --- Environment -----------------------------------------------------------

plane {
    point = 0.0 0.0 0.0
    normal = 0.0 1.0 0.0
    material = floor_mat
}

# 1. Main Centerpiece: Granite Sphere with Gold-Lined Cross Tunnels
# Sphere carved by two orthogonal cylinders
csg_difference {
    csg_difference {
        sphere {
            center = 0.0 1.0 0.0
            radius = 0.95
            material = granite_rock
        }
        cylinder {
            base = 0.0 1.0 -1.5
            top = 0.0 1.0 1.5
            r_bottom = 0.42
            r_top = 0.42
            material = gold_core
        }
    }
    cylinder {
        base = -1.5 1.0 0.0
        top = 1.5 1.0 0.0
        r_bottom = 0.42
        r_top = 0.42
        material = gold_core
    }
}

# 2. Left Object: Carved Stone Block with Cobalt Tunnel
csg_difference {
    box {
        center = -2.2 0.75 0.2
        half = 0.75 0.75 0.75
        material = carved_stone
    }
    cylinder {
        base = -2.2 0.75 -1.0
        top = -2.2 0.75 1.4
        r_bottom = 0.45
        r_top = 0.45
        material = cobalt_core
    }
}

# 3. Right Object: Emerald Glass Lens (Intersection of two spheres) on Brass Pedestal
csg_intersection {
    sphere {
        center = 1.8 1.1 -0.3
        radius = 0.85
        material = emerald_glass
    }
    sphere {
        center = 1.8 1.1 0.5
        radius = 0.85
        material = emerald_glass
    }
}

# Pedestal under the lens
cylinder {
    base = 1.8 0.0 0.1
    top = 1.8 0.55 0.1
    r_bottom = 0.42
    r_top = 0.32
    material = brass_pedestal
}
