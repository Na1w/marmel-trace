# scenes/example_glossy.scene
#
# A focused demonstration of ROUGHNESS-BLURRED ("glossy") METAL REFLECTIONS.
# Where scenes/example_materials.scene shows that roughness widens the direct
# SUN highlight, this scene shows the OTHER half of the model: the *recursive
# environment reflection* is itself importance-sampled with a GGX lobe whose
# width is driven by the same `roughness` value.
#
# How the glossy path is selected (see src/render.c, trace_hit):
#   the roughness-blurred reflection is taken ONLY when ALL of
#       pbr != 0            (the metallic/roughness BRDF is active)
#       reflectivity > 0    (the mirror pass is switched on)
#       roughness > 1e-6    (the lobe is not a perfect delta mirror)
#   are true. In that case the renderer casts GLOSSY_REFLECTION_SAMPLES (16)
#   recursive rays, each importance-sampled from the material's GGX
#   alpha = max(roughness^2, 1e-4), and averages them. Every other material
#   (and every roughness = 0 metal) falls back to the legacy single sharp
#   mirror ray, so adding this file cannot change any existing render.
#
# The material keys used here:
#   type        = <conductor preset>  -- gold / copper / chrome supply the
#                                        metal F0 (albedo), metallic = 1,
#                                        pbr = 1 and a polished roughness.
#   reflectivity = 0 .. 1             -- explicit override; the presets ship
#                                        with 0, so we raise it to switch the
#                                        blurred reflection ON.
#   roughness    = 0 .. 1             -- explicit override; the microfacet
#                                        width. 0.02 is a near-mirror, 0.7 is
#                                        a broad satin blur.
#
# The scene: a row of four GOLD conductors whose roughness ramps
#   0.02  ->  0.15  ->  0.40  ->  0.70   (left to right)
# so the reflection of the environment visibly softens and spreads as you read
# across the row. They stand on a high-contrast checkerboard floor and in front
# of three saturated backdrop slabs (red / green / blue), so every sphere
# reflects sharp, high-frequency detail at roughness 0.02 and a diffuse colour
# wash at roughness 0.70. Two extra spheres behind (chrome 0.08, copper 0.25)
# exercise more named conductor presets.
#
# NOTE: this Whitted raytracer tints the *direct* term by the metal colour but
# reflects the environment untinted, so the gold/copper hue reads through the
# non-reflective fraction (1 - reflectivity) and the sun highlight while the
# reflected image supplies the contrast that makes the blur legible.
#
# Render it with:
#   ./raytracer --scene scenes/example_glossy.scene \
#               --width 320 --height 180 --samples 8 --out output/example_glossy.bmp
#
# Try the effect toggles:
#   * set every `roughness = 0`   -> all four mirrors snap back to razor sharp
#                                    (single-ray legacy path); compare the row.
#   * set `reflectivity = 0`      -> the blurred reflection switches off and
#                                    only the gold PBR sun highlight remains.

# --- Globals ---------------------------------------------------------------
# No water surface in this scene; keep the ground plane dry.
water_enabled = 0
water_material = none

# --- Camera ----------------------------------------------------------------
# Eye a little above the row, looking down the -Z axis so the four gold
# spheres sit on one clean horizontal line and their reflections line up for
# an easy left-to-right roughness comparison.
camera {
    eye = 0 3.2 13
    target = 0 1.5 -3
    up = 0 1 0
    vfov = 40
}

# --- Sky -------------------------------------------------------------------
# A bright, clean day sky. The sun is placed toward the camera side (positive
# Z) so the specular glint lands on the near hemisphere of every sphere, where
# the roughness gradient is easiest to read.
sky {
    sun_dir = -0.35 0.72 0.60
    sun_color = 1 0.96 0.90
    horizon_color = 0.80 0.88 1.00
    zenith_color = 0.30 0.50 0.95
    gradient_gamma = 0.65
    sun_glow_exponent = 320
    sun_glow_strength = 0.85
    cloud_height = 120
    cloud_scale = 0.0025
    cloud_coverage = 0.40
    cloud_softness = 0.15
    cloud_sharpness = 1.4
    cloud_octaves = 5
    seed = 7331
}

# --- Materials -------------------------------------------------------------
# High-contrast checkerboard floor. The pattern is a function of the
# world-space hit position (texture_scale = world units per cell), so its
# compressed reflection across each sphere is full of sharp edges: exactly the
# detail the GGX lobe erases as `roughness` grows. Bright warm cells alternate
# with near-black blue cells so the contrast survives the tone map.
material checker_floor {
    albedo = 1 1 1
    specular = 0.05 0.05 0.05
    shininess = 16
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
    texture = checker
    texture_scale = 1.0
    texture_color_a = 1.00 0.95 0.82
    texture_color_b = 0.04 0.06 0.12
}

# Saturated, matte backdrop slabs. These sit behind the row and fill the upper
# half of every sphere's reflection with large flat colour fields, so a sharp
# mirror shows hard colour boundaries while a rough one shows a soft gradient.
material slab_red {
    albedo = 0.85 0.08 0.07
    specular = 0.10 0.10 0.10
    shininess = 32
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
}

material slab_green {
    albedo = 0.10 0.75 0.18
    specular = 0.10 0.10 0.10
    shininess = 32
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
}

material slab_blue {
    albedo = 0.08 0.20 0.85
    specular = 0.10 0.10 0.10
    shininess = 32
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
}

# --- Glossy conductors: the roughness ramp ---------------------------------
# All four share the SAME gold preset and the SAME reflectivity, so the only
# variable across the row is `roughness`. `reflectivity = 0.8` raises it above
# the preset's 0 so the 16-sample GGX reflection is actually taken.
material gloss_gold_002 {
    type = gold
    reflectivity = 0.8
    roughness = 0.02
}
material gloss_gold_015 {
    type = gold
    reflectivity = 0.8
    roughness = 0.15
}
material gloss_gold_040 {
    type = gold
    reflectivity = 0.8
    roughness = 0.40
}
material gloss_gold_070 {
    type = gold
    reflectivity = 0.8
    roughness = 0.70
}

# --- Extra conductor presets with explicit roughness overrides -------------
# chrome's polished preset roughness is 0.03 and copper's is 0.05; both are
# overridden here to show the presets driving the same glossy path.
material gloss_chrome_008 {
    type = chrome
    reflectivity = 0.8
    roughness = 0.08
}
material gloss_copper_025 {
    type = copper
    reflectivity = 0.8
    roughness = 0.25
}

# --- Primitives ------------------------------------------------------------
# Infinite checkerboard ground plane at y = 0.
plane {
    point = 0 0 0
    normal = 0 1 0
    material = checker_floor
}

# Front row: four gold conductors, roughness ramping left to right.
# (centre y = radius = 1.3, so each rests exactly on the floor)
sphere {
    center = -6.0 1.3 -1.0
    radius = 1.3
    material = gloss_gold_002
}
sphere {
    center = -2.0 1.3 -1.0
    radius = 1.3
    material = gloss_gold_015
}
sphere {
    center = 2.0 1.3 -1.0
    radius = 1.3
    material = gloss_gold_040
}
sphere {
    center = 6.0 1.3 -1.0
    radius = 1.3
    material = gloss_gold_070
}

# Back row: two more conductor presets, framed by the colour slabs.
sphere {
    center = -4.0 1.3 -7.0
    radius = 1.3
    material = gloss_chrome_008
}
sphere {
    center = 4.0 1.3 -7.0
    radius = 1.3
    material = gloss_copper_025
}

# Three tall saturated slabs forming the high-contrast backdrop.
box {
    center = -5.0 2.6 -9.0
    half = 1.2 2.6 0.6
    material = slab_red
}
box {
    center = 0.0 2.6 -9.0
    half = 1.2 2.6 0.6
    material = slab_green
}
box {
    center = 5.0 2.6 -9.0
    half = 1.2 2.6 0.6
    material = slab_blue
}
