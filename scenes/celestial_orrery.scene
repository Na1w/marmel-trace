# scenes/celestial_orrery.scene
#
# "The Grand Astronomical Orrery"
#
# A magnificent clockwork astronomical orrery constructed from polished brass,
# gold, copper, and precious gemstone planets hovering above a checkered observatory floor.
#
# Key Features:
#   * Blazing miniature star: central emissive area light illuminating the planetary system
#   * Intricate planets:
#       - Mercury: scorched polished gunmetal iron
#       - Venus: polished brass
#       - Earth: deep sapphire glass ocean sphere with orbiting diamond moon
#       - Mars: glowing ruby glass crystal
#       - Jupiter: massive striped gas giant (procedural stripes texture)
#       - Saturn: golden globe surrounded by particulate planetary rings
#   * Armillary gimbal pillars and observation arches constructed in polished brass and ebony
#   * Checkered observatory floor reflecting the machinery and planets
#   * Subtle optical depth of field focusing sharply on Earth and the Sun
#
# Render:
#   ./raytracer --scene scenes/celestial_orrery.scene --pathtrace \
#               --width 1280 --height 720 --samples 32 --depth 6 \
#               --out output/celestial_orrery.bmp

water_enabled = 0
water_material = none
camera {
    eye = -2.8 5.6 11
    target = 0 3.8 0
    up = 0 1 0
    vfov = 44.0
    aperture = 0.015
    focus_distance = 11.8
}
