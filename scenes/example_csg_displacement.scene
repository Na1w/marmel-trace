# scenes/example_csg_displacement.scene
#
# Demonstration scene for:
#   1. Named Displacement Modifiers (`displace <name> { ... }`)
#   2. Modulated primitives (`box { ... displace = <name> }`)
#   3. Constructive Solid Geometry (`csg { ... }`)
#   4. Displaced / warped CSG shapes (`csg { ... displace = <name> }`)

camera {
    eye = 0 4.5 9
    target = 0 1.6 0
    up = 0 1 0
    vfov = 38
}

sky {
    sun_dir = 0.4 0.8 -0.45
    sun_color = 1.0 0.95 0.88
    horizon_color = 0.75 0.85 0.98
    zenith_color = 0.30 0.50 0.90
    sun_radius = 2.0
}

# --- Materials ----------------------------------------------------
material floor {
    albedo = 0.45 0.45 0.48
    texture = checker
    texture_scale = 1.0
    texture_color_a = 0.6 0.6 0.65
    texture_color_b = 0.3 0.3 0.33
    specular = 0.1 0.1 0.1
    shininess = 32
}

material gold_mat {
    type = gold
    roughness = 0.15
}

material copper_mat {
    type = copper
    roughness = 0.2
}

material silver_mat {
    type = silver
    roughness = 0.12
}

material ceramic_teal {
    type = ceramic
    albedo = 0.1 0.55 0.6
    roughness = 0.08
}

material ruby {
    albedo = 0.9 0.1 0.15
    roughness = 0.1
    specular = 0.8 0.8 0.8
    shininess = 128
}

# --- Floor Plane --------------------------------------------------
plane {
    point = 0 0 0
    normal = 0 1 0
    material = floor
}

# --- Displacement Modifiers ---------------------------------------

# 1. Harmonic Sine Wobble (bends space back and forth)
displace my_wobble {
    type = sine
    direction = 1 0 0
    amplitude = 0.35
    frequency = 1.4
    phase = 0.0
}

# 2. Continuous Twist (rotates space around the vertical Y-axis)
displace my_twist {
    type = twist
    strength = 0.75
}

# 3. Organic 3D Perlin Noise (sculpted/gnarled look)
displace my_noise {
    type = noise
    amplitude = 0.18
    frequency = 1.5
    seed = 4242
}

# --- Objects ------------------------------------------------------

# Object 1 (far left, x = -3.8):
# Reference standard box - straight, crisp, unmodified
box {
    center = -3.8 1.6 0
    half = 0.55 1.5 0.55
    material = gold_mat
}

# Object 2 (mid-left, x = -1.9):
# Same box, but modulated by `my_wobble` -> wobbly, S-curved pillar!
box {
    center = -1.9 1.6 0
    half = 0.55 1.5 0.55
    material = gold_mat
    displace = my_wobble
}

# Object 3 (center, x = 0.0):
# Same box, modulated by `my_twist` -> twisted pillar!
box {
    center = 0.0 1.6 0
    half = 0.55 1.5 0.55
    material = silver_mat
    displace = my_twist
}

# Object 4 (mid-right, x = 1.9):
# CSG Difference: Box with a cylindrical tunnel carved through it
# (crisp, unwarped CSG)
csg {
    operation = difference
    material = copper_mat

    shape_a = box
    center_a = 1.9 1.6 0
    half_a = 0.65 1.5 0.65

    shape_b = cylinder
    center_b = 1.9 1.6 0
    radius_b = 0.42
    height_b = 3.5
}

# Object 5 (far right, x = 3.8):
# CSG Difference + CHAINED DISPLACEMENTS COMBINED!
# The carved box is both twisted AND curved in an S-shape!
csg {
    operation = difference
    material = ceramic_teal
    displace = my_twist my_wobble

    shape_a = box
    center_a = 3.8 1.6 0
    half_a = 0.65 1.5 0.65

    shape_b = cylinder
    center_b = 3.8 1.6 0
    radius_b = 0.42
    height_b = 3.5
}
