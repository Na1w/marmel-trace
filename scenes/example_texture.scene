# scenes/example_texture.scene
#
# Demonstration scene showcasing BMP Image Texture Mapping & UV mapping:
#   - Equirectangular UV mapping on a sphere (globe.bmp)
#   - Face-aligned box UV mapping on a wooden crate (crate.bmp)
#   - Tiled plane texture mapping (tiles.bmp)
#   - Built-in uv_checker texture on a cylinder

camera {
    eye = 0 2.8 6.5
    target = 0 1.2 0
    up = 0 1 0
    vfov = 38
}

sky {
    sun_dir = 0.45 0.75 -0.5
    sun_color = 1.0 0.98 0.92
    horizon_color = 0.78 0.86 0.98
    zenith_color = 0.28 0.48 0.90
    sun_radius = 2.0
}

# --- Materials ----------------------------------------------------

# Tiled floor using BMP image texture
material tiled_floor {
    albedo = 1.0 1.0 1.0
    texture = image
    texture_file = "textures/tiles.bmp"
    texture_scale = 0.25
    specular = 0.15 0.15 0.15
    shininess = 32
}

# Wooden crate material
material crate_mat {
    albedo = 1.0 1.0 1.0
    texture = image
    texture_file = "textures/crate.bmp"
    specular = 0.08 0.08 0.08
    shininess = 16
}

# Planet / Globe sphere material
material globe_mat {
    albedo = 1.0 1.0 1.0
    texture = image
    texture_file = "textures/globe.bmp"
    specular = 0.25 0.25 0.25
    shininess = 48
}

# Cylinder with procedural UV checkerboard
material checker_pedestal {
    albedo = 1.0 1.0 1.0
    texture = uv_checker
    texture_scale = 6.0
    texture_color_a = 0.9 0.85 0.75
    texture_color_b = 0.15 0.2 0.3
    specular = 0.2 0.2 0.2
    shininess = 32
}

# Polished gold sphere for rich specular reflections
material gold_accent {
    type = gold
    roughness = 0.08
}

# --- Objects ------------------------------------------------------

# Floor plane
plane {
    point = 0 0 0
    normal = 0 1 0
    material = tiled_floor
}

# Left: Wooden crate (box with automatic per-face UV mapping)
box {
    center = -2.0 0.9 0.2
    half = 0.9 0.9 0.9
    material = crate_mat
}

# Center: Planet globe (sphere with equirectangular UV mapping)
sphere {
    center = 0.0 1.5 -0.2
    radius = 1.1
    material = globe_mat
}

# Right: Decorative pedestal with UV checker pattern
cylinder {
    base = 2.0 0.0 0.2
    top = 2.0 1.2 0.2
    r_bottom = 0.75
    r_top = 0.75
    material = checker_pedestal
}

# Small gold sphere sitting on top of the cylinder pedestal
sphere {
    center = 2.0 1.55 0.2
    radius = 0.35
    material = gold_accent
}
