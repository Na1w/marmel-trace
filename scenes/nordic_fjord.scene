# scenes/nordic_fjord.scene
#
# "Nordic Fjord Sanctuary at Dawn"
#
# A tranquil Scandinavian fjord at crisp misty sunrise with a rustic timber pier,
# floating warm lanterns, mossy granite boulders, and diverse autumn/evergreen flora.
#
# Key Features:
#   * Deep fjord water with rippling waves and realistic teal-blue absorption
#   * Floating paper lanterns acting as warm emissive area lights (soft reflections on water)
#   * Rustic wooden dock/pier extending out from the rocky shore
#   * Custom Scandinavian Spruce pines and fiery golden/red autumn birch trees
#   * Granite boulders and shoreline stepping stones
#   * Soft sunrise dawn sky with warm horizon glow and soft shadow penumbra (sun_radius 5.0)
#
# Render:
#   ./raytracer --scene scenes/nordic_fjord.scene --pathtrace \
#               --width 1280 --height 720 --samples 32 --depth 6 \
#               --out output/nordic_fjord.bmp

water_level = 0.03
water_material = fjord_water
water_enabled = 1
camera {
    eye = 0.0 3.2 13.5
    target = 0.0 2.2 -6.0
    up = 0 1 0
    vfov = 45.0
    aperture = 0.015
    focus_distance = 16.5
}
sky {
    sun_dir = 0.75 0.18 -0.64
    sun_color = 1 0.75 0.44
    horizon_color = 0.98 0.64 0.42
    zenith_color = 0.16 0.26 0.56
    gradient_gamma = 0.85
    sun_glow_exponent = 150.0
    sun_glow_strength = 1.3
    sun_radius = 5.0
    cloud_height = 140.0
    cloud_scale = 0.003
    cloud_coverage = 0.55
    cloud_softness = 0.22
    cloud_sharpness = 1.3
    cloud_octaves = 6
    seed = 1984
}
