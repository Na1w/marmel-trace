# --- The Central Altar & CSG Relics ---------------------------------------

# Tiered Altar Platform
box {
    center = 0.0 0.2 -0.2
    half = 2.3 0.2 1.4
    material = dark_basalt
}
box {
    center = 0.0 0.575 -0.2
    half = 1.7 0.175 1.1
    material = dark_basalt
}

# Central Pedestal
cylinder {
    base = 0.0 0.75 -0.2
    top = 0.0 1.5 -0.2
    r_bottom = 1.05
    r_top = 0.92
    material = antique_marble
}

# Gold Plinth Collar
cylinder {
    base = 0.0 1.45 -0.2
    top = 0.0 1.55 -0.2
    r_bottom = 0.96
    r_top = 0.96
    material = polished_gold
}

# Relic 1: Carved Astrolabe Sphere (Nested CSG Difference: Obsidian Sphere - Cross-Bore Gold Cylinders)
csg_difference {
    material = carved_obsidian
    sphere {
        center = 0.0 2.45 -0.2
        radius = 0.78
    }
    csg_union {
        cylinder {
            base = 0.0 2.45 -1.2
            top = 0.0 2.45 1.2
            r_bottom = 0.42
            r_top = 0.42
            material = polished_gold
        }
        cylinder {
            base = -1.2 2.45 -0.2
            top = 1.2 2.45 -0.2
            r_bottom = 0.34
            r_top = 0.34
            material = polished_gold
        }
    }
}

# Floating Emissive Core inside the carved astrolabe cavity
sphere {
    center = 0.0 2.45 -0.2
    radius = 0.23
    material = celestial_crystal
}

# Celestial Relic Light (Area Light Glow)
light {
    position = 0.0 2.45 -0.2
    color = 0.35 0.75 1.0
    intensity = 26.0
    radius = 0.15
}

# Relic 2 (Left): Biconvex Sapphire Lens (CSG Intersection: 2 Overlapping Spheres)
# Stand
cylinder {
    base = -1.05 0.75 0.15
    top = -1.05 1.35 0.15
    r_bottom = 0.14
    r_top = 0.06
    material = antique_bronze
}
# Biconvex Lens
csg_intersection {
    material = sapphire_lens
    sphere {
        center = -1.05 1.70 0.48
        radius = 0.46
    }
    sphere {
        center = -1.05 1.70 -0.18
        radius = 0.46
    }
}

# Relic 3 (Right): Gilded Sacrificial Chalice (CSG Difference: Gold Sphere - Ruby Hollow)
# Stand
cylinder {
    base = 1.05 0.75 0.15
    top = 1.05 1.25 0.15
    r_bottom = 0.18
    r_top = 0.08
    material = polished_gold
}
# Hollow Cup
csg_difference {
    material = polished_gold
    sphere {
        center = 1.05 1.55 0.15
        radius = 0.36
    }
    sphere {
        center = 1.05 1.68 0.15
        radius = 0.32
        material = ruby_gem
    }
}

