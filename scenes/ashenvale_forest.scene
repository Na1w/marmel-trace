# scenes/ashenvale_forest.scene
#
# Recreation of the enchanted morning forest from example_scene.png:
#   * Morning sun blooming in the upper-left with volumetric Mie god-rays
#   * Dusky amethyst/purple mist settling into the woodland floor and right glade
#   * Rolling velvety moss mounds and lichen-encrusted boulders
#   * Massive ancient central tree with sprawling buttress roots and dense canopy
#   * Dark foreground tree framing the sun on the left
#   * Purple/plum-foliaged canopies on the right
#   * Weathered elven ruin columns and architraves nestled in the mist

camera {
    eye = 0.0 1.9 9.5
    target = 0.2 2.1 0.0
    up = 0 1 0
    vfov = 43.0
}

sky {
    sun_dir = -0.34 0.28 -0.90
    sun_color = 1.95 1.45 0.80
    horizon_color = 0.45 0.22 0.42
    zenith_color = 0.12 0.07 0.22
    gradient_gamma = 0.80
    sun_glow_exponent = 800.0
    sun_glow_strength = 0.8
    sun_radius = 2.4
    cloud_height = 140.0
    cloud_scale = 0.0028
    cloud_coverage = 0.18
    cloud_softness = 0.20
    cloud_sharpness = 1.3
    seed = 777
}

fog {
    density = 0.016
    color = 0.36 0.15 0.40
    height = 5.2
    height_falloff = 0.18
    inscatter_strength = 0.45
    sun_anisotropy = 0.82
    noise_scale = 0.16
    noise_amount = 0.25
    shadow_steps = 10
}

# --- Materials -------------------------------------------------------------

material moss_turf {
    pbr = 1
    albedo = 0.14 0.25 0.09
    roughness = 0.90
    bump_strength = 0.12
    bump_scale = 1.5
}

material moss_rock {
    pbr = 1
    albedo = 0.20 0.24 0.16
    roughness = 0.85
    bump_strength = 0.15
    bump_scale = 1.2
}

material ancient_bark {
    pbr = 1
    albedo = 0.15 0.11 0.08
    roughness = 0.90
    bump_strength = 0.22
    bump_scale = 2.0
}

material dark_bark {
    pbr = 1
    albedo = 0.04 0.03 0.03
    roughness = 0.95
}

material nightelf_canopy {
    pbr = 1
    albedo = 0.13 0.25 0.08
    specular = 0.04 0.06 0.03
    roughness = 0.65
}

material purple_canopy {
    pbr = 1
    albedo = 0.32 0.08 0.24
    specular = 0.05 0.03 0.06
    roughness = 0.60
}

material dark_leaf {
    pbr = 1
    albedo = 0.05 0.08 0.04
    roughness = 0.85
}

material red_shrub {
    pbr = 1
    albedo = 0.52 0.08 0.18
    roughness = 0.70
}

material spruce_bark {
    pbr = 1
    albedo = 0.14 0.10 0.07
    roughness = 0.90
}

material spruce_needles {
    pbr = 1
    albedo = 0.05 0.14 0.06
    specular = 0.04 0.06 0.03
    roughness = 0.55
}

material elven_marble {
    pbr = 1
    albedo = 0.46 0.44 0.48
    specular = 0.06 0.06 0.06
    roughness = 0.68
    bump_strength = 0.08
    bump_scale = 3.0
}

# --- Terrain & Moss Mounds -------------------------------------------------

# Ground base plane
plane {
    point = 0.0 0.0 0.0
    normal = 0.0 1.0 0.0
    material = moss_turf
}

# Rolling mossy central mound where the ancient tree sits
sphere {
    center = 0.6 -8.9 0.5
    radius = 9.8
    material = moss_turf
}

# Left bank rising under framing silhouette tree
sphere {
    center = -4.0 -8.6 4.5
    radius = 9.6
    material = moss_turf
}

# Right rising glade mound
sphere {
    center = 4.8 -8.7 2.5
    radius = 9.6
    material = moss_turf
}

# Foreground right prominent mossy boulder
boulder {
    position = 2.4 0.30 6.6
    radius = 1.35
    roughness = 0.32
    flatness = 0.74
    seed = 202
    material = moss_rock
}

# Foreground left mossy boulder
boulder {
    position = -1.9 0.25 6.8
    radius = 1.15
    roughness = 0.35
    flatness = 0.72
    seed = 101
    material = moss_rock
}

# Foreground low mossy stones in pathway
boulder {
    position = -0.3 0.04 7.6
    radius = 0.65
    roughness = 0.34
    flatness = 0.78
    seed = 456
    material = moss_rock
}

boulder {
    position = 1.2 0.04 7.8
    radius = 0.75
    roughness = 0.32
    flatness = 0.76
    seed = 789
    material = moss_rock
}

# Midground boulders hugging the central mound base
boulder {
    position = -0.8 0.65 1.2
    radius = 1.15
    roughness = 0.32
    flatness = 0.74
    seed = 303
    material = moss_rock
}

boulder {
    position = 1.8 0.60 0.6
    radius = 1.15
    roughness = 0.30
    flatness = 0.76
    seed = 404
    material = moss_rock
}

boulder {
    position = 0.2 0.80 1.5
    radius = 0.80
    roughness = 0.30
    flatness = 0.78
    seed = 505
    material = moss_rock
}

# Small reddish-magenta flower dots nestled on the central moss mound
sphere {
    center = -0.4 1.05 0.8
    radius = 0.12
    material = red_shrub
}
sphere {
    center = -0.2 1.02 1.0
    radius = 0.10
    material = red_shrub
}
sphere {
    center = -0.6 0.95 1.2
    radius = 0.13
    material = red_shrub
}
sphere {
    center = 1.1 0.92 0.4
    radius = 0.11
    material = red_shrub
}
sphere {
    center = 1.3 0.85 0.6
    radius = 0.10
    material = red_shrub
}
sphere {
    center = -1.4 0.70 2.8
    radius = 0.12
    material = red_shrub
}

# --- Central Ancient Tree & Canopy -----------------------------------------

# Massive ancient trunk rising high into the mist (positioned to the right of the opening)
cylinder {
    base = 0.8 0.0 -3.0
    top = 0.8 12.0 -3.0
    r_bottom = 1.60
    r_top = 1.20
    material = ancient_bark
}

# Buttress root 1 (left flare)
cylinder {
    base = -0.4 0.4 -2.0
    top = 0.6 3.2 -2.8
    r_bottom = 0.55
    r_top = 0.22
    material = ancient_bark
}

# Buttress root 2 (right flare)
cylinder {
    base = 2.0 0.4 -2.2
    top = 1.0 3.0 -2.9
    r_bottom = 0.55
    r_top = 0.22
    material = ancient_bark
}

# Buttress root 3 (forward center flare)
cylinder {
    base = 0.8 0.6 -1.6
    top = 0.8 2.6 -2.7
    r_bottom = 0.50
    r_top = 0.18
    material = ancient_bark
}

# Foreground leafy tree in front of the giant trunk:
# Raised base on mound, full rounded crown with real 3D polygonal diamond leaves
tree {
    position = 0.5 0.2 -1.0
    height = 3.3
    radius = 0.28
    seed = 101
    foliage = leaves
    max_depth = 4
    spread_deg = 36.0
    len_decay = 0.74
    leaf_min = 4
    leaf_span = 3
    min_branch_radius = 0.02
    material_bark = ancient_bark
    material_leaf = nightelf_canopy
}

# Secondary higher canopy behind giant trunk with real 3D polygonal diamond leaves
tree {
    position = 0.9 0.0 -3.6
    height = 3.6
    radius = 0.30
    seed = 303
    foliage = leaves
    max_depth = 4
    spread_deg = 35.0
    leaf_min = 3
    leaf_span = 2
    material_bark = ancient_bark
    material_leaf = nightelf_canopy
}

# --- Left Foreground Framing Tree (Dark silhouette framing morning sun) ----

# Prominent dark silhouette trunk on the left edge of frame
cylinder {
    base = -2.7 0.0 5.0
    top = -2.5 4.2 4.4
    r_bottom = 0.65
    r_top = 0.42
    material = dark_bark
}

cylinder {
    base = -2.5 4.2 4.4
    top = -2.7 7.5 4.0
    r_bottom = 0.42
    r_top = 0.30
    material = dark_bark
}

# Root reaching forward into the left bank
cylinder {
    base = -2.2 0.2 5.6
    top = -2.6 1.6 5.1
    r_bottom = 0.32
    r_top = 0.16
    material = dark_bark
}

# Gnarled branch arching across the top left
cylinder {
    base = -2.5 3.8 4.2
    top = -1.2 5.4 3.0
    r_bottom = 0.28
    r_top = 0.12
    material = dark_bark
}

# Branch arching toward center top framing
cylinder {
    base = -1.2 5.4 3.0
    top = -0.3 5.0 2.2
    r_bottom = 0.14
    r_top = 0.08
    material = dark_bark
}

# Upper branch slicing the sun disk to create god ray 1
cylinder {
    base = -2.3 4.3 4.0
    top = -1.0 4.2 2.6
    r_bottom = 0.12
    r_top = 0.05
    material = dark_bark
}

# Mid branch slicing the sun disk to create god ray 2
cylinder {
    base = -2.2 3.5 4.2
    top = -1.2 3.2 2.8
    r_bottom = 0.10
    r_top = 0.04
    material = dark_bark
}

# Drooping twig cutting across the bright sun glare
