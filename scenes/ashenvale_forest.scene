    height = 5.6
    radius = 0.24
    seed = 765
    foliage = leaves
    max_depth = 4
    spread_deg = 32.0
    leaf_min = 2
    leaf_span = 2
    material_bark = dark_bark
    material_leaf = dark_leaf
}

# --- Right Glade Trees (Purple / Plum Canopies) -----------------------------

# Medium purple canopy tree hovering over the elven ruins with 3D diamond leaves
