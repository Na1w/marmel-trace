    position = -1.6 0.0 -4.5
    height = 5.2
    radius = 0.22
    seed = 654
    foliage = leaves
    max_depth = 4
    spread_deg = 34.0
    leaf_min = 2
    leaf_span = 2
    material_bark = dark_bark
    material_leaf = dark_leaf
}

tree {
