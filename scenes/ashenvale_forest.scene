    base = -1.0 4.2 2.6
    top = -0.7 3.5 2.5
    r_bottom = 0.05
    r_top = 0.02
    material = dark_bark
}

# Hanging vine / secondary droop branch
cylinder {
    base = -1.7 4.5 3.5
    top = -1.5 2.8 3.2
    r_bottom = 0.06
    r_top = 0.03
    material = dark_bark
}

# Left foreground framing tree with real 3D polygonal diamond leaves framing the morning sun
tree {
    position = -2.7 0.0 4.4
    height = 5.4
    radius = 0.32
    seed = 888
    foliage = leaves
    max_depth = 4
    spread_deg = 36.0
    len_decay = 0.72
    leaf_min = 2
    leaf_span = 2
    material_bark = dark_bark
    material_leaf = dark_leaf
}

# Background silhouette trees in the morning sun gap (breaking light into god-ray shafts)
