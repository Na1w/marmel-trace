# --- Nordic Spruces in the Distant Morning Mist ----------------------------

# Conifer silhouetted behind the elven ruins in the purple haze
spruce {
    position = 3.8 0.0 -5.8
    height = 6.2
    radius = 0.24
    seed = 101
    material_bark = spruce_bark
    material_leaf = spruce_needles
}

# Background spruce deep in the mist (center-left)
spruce {
    position = -1.4 0.0 -9.5
    height = 6.5
    radius = 0.25
    seed = 303
    material_bark = spruce_bark
    material_leaf = spruce_needles
}

# Distant colossal tree trunk in the purple haze
cylinder {
    base = 5.0 0.0 -7.5
    top = 5.0 13.0 -7.5
    r_bottom = 1.50
    r_top = 1.20
    material = dark_bark
}

