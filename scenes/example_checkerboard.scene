# scenes/example_checkerboard.scene
#
# A small, hand-written scene that showcases the PROCEDURAL TEXTURES added to
# the material system (see docs/scene_format.md, §4.3 "Procedural textures").
#
# The texture keys, explained:
#   texture          = none | checker | stripes   (default: none)
#   texture_scale    = world units per cell        (default: 1; must be > 0)
#   texture_color_a  = linear RGB of the first cell/band   (default: 1 1 1)
#   texture_color_b  = linear RGB of the second cell/band  (default: 0 0 0)
#
# How they behave (patterns are functions of the WORLD-SPACE hit position):
#   * checker - a 3D checkerboard. The parity of
#               floor(p.x/s) + floor(p.y/s) + floor(p.z/s) picks colour A or B.
#               On the flat floor (y = 0) this collapses to a classic 2D
#               checkerboard of (floor(x)+floor(z)) cells.
#   * stripes - sinusoidal bands along world Y, period 1/texture_scale:
#               a band is colour A when 0.5*(1+sin(2*pi*p.y/s)) >= 0.5, else B.
#   * The selected pattern colour is MULTIPLIED by the base `albedo`, so an
#     albedo of `1 1 1` lets texture_color_a/b define the colours verbatim.
#
# The scene: a checkerboard floor, a striped sphere, and one plain untextured
# cube for contrast, under a clear day sky.
#
# Render it with:
#   ./raytracer --scene scenes/example_checkerboard.scene \
#               --width 320 --height 180 --samples 8 --out /tmp/ex_checkerboard.bmp

# --- Globals ---------------------------------------------------------------
# This scene has no water, so disable the water pass explicitly.
water_enabled = 0
water_material = none

# --- Camera ----------------------------------------------------------------
# Eye slightly above the floor, looking down at the objects.
camera {
    eye = 0 3.5 11
    target = 0 1.4 -1
    up = 0 1 0
    vfov = 45
}

# --- Sky -------------------------------------------------------------------
# A bright, clean daytime sky so the textures are lit neutrally.
sky {
    sun_dir = 0.5 0.6 -0.6
    sun_color = 1 0.97 0.9
    horizon_color = 0.8 0.88 1
    zenith_color = 0.3 0.5 0.95
    gradient_gamma = 0.7
    sun_glow_exponent = 300
    sun_glow_strength = 0.8
    cloud_height = 120
    cloud_scale = 0.0025
    cloud_coverage = 0.4
    cloud_softness = 0.15
    cloud_sharpness = 1.4
    cloud_octaves = 5
    seed = 4242
}

# --- Materials -------------------------------------------------------------
# Checkerboard floor: white albedo (so the pattern colours show verbatim),
# 1-unit cells alternating light grey and near-black blue.
material checker_floor {
    albedo = 1 1 1
    specular = 0.05 0.05 0.05
    shininess = 16
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
    texture = checker
    texture_scale = 1.0
    texture_color_a = 0.92 0.92 0.92
    texture_color_b = 0.12 0.14 0.18
}

# Striped sphere: horizontal bands along world Y. texture_scale = 3 gives a
# period of 1/3 world unit, i.e. ~9 bands across the 3-unit diameter.
material stripes_ball {
    albedo = 1 1 1
    specular = 0.2 0.2 0.2
    shininess = 32
    reflectivity = 0.05
    transparency = 0
    ior = 1
    is_water = 0
    texture = stripes
    texture_scale = 3
    texture_color_a = 0.85 0.25 0.15
    texture_color_b = 0.15 0.55 0.85
}

# An ordinary, untextured material for contrast (no texture* keys at all, so
# it is a flat per-primitive albedo just like every pre-texture material).
material matte_blue {
    albedo = 0.2 0.35 0.75
    specular = 0.1 0.1 0.1
    shininess = 24
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
}

# --- Primitives ------------------------------------------------------------
# Infinite ground plane at y = 0 carrying the checkerboard.
plane {
    point = 0 0 0
    normal = 0 1 0
    material = checker_floor
}

# A striped sphere resting on the floor (centre y = radius = 1.5).
sphere {
    center = -1.2 1.5 -1
    radius = 1.5
    material = stripes_ball
}

# A plain blue cube for contrast (half-extent 0.9, sitting on the floor).
box {
    center = 2.6 0.9 -0.5
    half = 0.9 0.9 0.9
    material = matte_blue
}
