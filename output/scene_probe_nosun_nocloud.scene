# Minimal deep-water absorption test (diagnostic A, t-121).
# Camera above a DEEP water box; an opaque grey floor sits at the box bottom
# so a refracted ray travels a known, large distance inside the water before
# it hits the floor. No trees / bushes so the water dominates the frame.

water_level = 0.02
water_material = water
water_enabled = 1

camera {
    eye = 0 8 30
    target = 0 0 -10
    up = 0 1 0
    vfov = 40
}

sky {
    sun_dir = 0.4466625002869186 0.7444375004781977 -0.4962916669854651
    sun_color = 0 0 0
    horizon_color = 0 0 0
    zenith_color = 0 0 0
    gradient_gamma = 0.6
    sun_glow_exponent = 350
    sun_glow_strength = 0
    cloud_coverage = -1.0
    seed = 1337
}

material floor {
    albedo = 0.8 0.8 0.8
    specular = 0 0 0
    shininess = 8
    reflectivity = 0
    transparency = 0
    ior = 1
    is_water = 0
    absorption = 0 0 0
    deep_color = 0 0 0
}

material water {
    albedo = 0.05 0.15 0.20
    specular = 0.90 0.90 0.90
    shininess = 256
    reflectivity = 1
    transparency = 0.85
    ior = 1.33
    is_water = 1
    absorption = 0.45 0.12 0.06
    deep_color = 0.02 0.10 0.16
}

# Opaque grey floor 10 m below the water surface.
plane {
    point = 0 -10 0
    normal = 0 1 0
    material = floor
}

# Deep water: top at y=0, bottom at y=-10 (10 m thick).
box {
    center = 0 -5 -10
    half = 60 5 60
    material = water
}
